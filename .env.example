# Telegram Bot API Token (получите у @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Прокси (если api.telegram.org блокируется провайдером):
# Поддерживаются: socks5://127.0.0.1:10808, http://127.0.0.1:7890 и др.
# TELEGRAM_PROXY_URL="socks5://127.0.0.1:10808"

# Настройки режима сна по умолчанию (23:00 — 09:00)
DEFAULT_SLEEP_START_HOUR=23
DEFAULT_SLEEP_END_HOUR=9

# Часовой пояс по умолчанию (UTC+3 для МСК)
DEFAULT_TIMEZONE_OFFSET=3

# Интервал проверки уведомлений (в секундах)
NOTIFICATION_CHECK_INTERVAL_SECONDS=60

# Кулдаун между повторными уведомлениями (в часах)
NOTIFICATION_COOLDOWN_HOURS=3
